# Copy this file to scripts/deploy.targets.env and customize values.
#
# Target variable format:
#   TARGET_<name>_HOST=...
#   TARGET_<name>_PORT=22
#   TARGET_<name>_USER=...
#   TARGET_<name>_DEPLOY_PATH=...
#   TARGET_<name>_PROFILE=full|monitor-only
#   TARGET_<name>_AUTH=key|password
#   TARGET_<name>_KEY_PATH=/path/to/private/key
#   TARGET_<name>_PASSWORD=optional_password
#   TARGET_<name>_ENV_FILE=.env.production
#   TARGET_<name>_REMOTE_ENV_NAME=.env
#   TARGET_<name>_DOCKER_USE_SUDO=true|false
#   TARGET_<name>_PURGE_MODE=managed|full
#   TARGET_<name>_SMOKE_CHECK=true|false
#
# Example target: full-stack production host
TARGET_orion_HOST=203.0.113.24
TARGET_orion_PORT=22
TARGET_orion_USER=deploy
TARGET_orion_DEPLOY_PATH=/srv/virgilio
TARGET_orion_PROFILE=full
TARGET_orion_AUTH=key
# TARGET_orion_KEY_PATH=/home/example/.ssh/id_ed25519
# TARGET_orion_PASSWORD=replace_me_if_using_password_auth
TARGET_orion_ENV_FILE=.env.production
TARGET_orion_REMOTE_ENV_NAME=.env
TARGET_orion_DOCKER_USE_SUDO=true
TARGET_orion_PURGE_MODE=managed
TARGET_orion_SMOKE_CHECK=true

# Example second host (monitor-only with SSH key auth)
